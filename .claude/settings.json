{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push*--force*)",
      "Bash(git push*--delete*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git commit --amend*)",
      "Bash(gh pr merge*--admin*)",
      "Bash(gh pr review --approve*)",
      "Bash(gh api graphql*addPullRequestReview*)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)"
    ],
    "allow": [
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh workflow run *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull --no-rebase*)",
      "Bash(git push -u origin *)",
      "Bash(git push)",
      "Bash(tools/board *)",
      "Bash(tools/task *)",
      "Bash(tools/wt *)",
      "Bash(tools/onboard*)",
      "Bash(tools/kickoff *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-edit-on-main.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bash-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/board-session-start.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/board-prompt.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
