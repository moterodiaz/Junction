# Every environment variable the backend reads (backend/app/config.py).
# On Modal these live in the "metalab" secret, e.g.:
#   modal secret create metalab NVIDIA_API_KEY=... GEMINI_API_KEY=...
# Locally: copy this file to backend/.env (gitignored), fill it in, then export the values
# into your shell (e.g. `set -a; source backend/.env; set +a`); the backend does not read the
# file itself. Never commit real keys.

# Required. On Modal the container refuses to start without them; locally, offline stubs run instead.
NVIDIA_API_KEY=        # build.nvidia.com, for page reading
GEMINI_API_KEY=        # aistudio.google.com, for reasoning, images and TTS (image models need pay-as-you-go billing)

# Optional. Defaults follow PRD section 4, Models.
# IMAGE_BASE_URL=https://<workspace>--metalab-web.modal.run  # public https URL of this app; without it
#                                     # card.image_url and card.audio_url are always null
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# MODEL_READ=nvidia/nemotron-3.5-super-vl-120b-a12b
# READ_FALLBACK_AFTER_S=8               # Gemini reads the page if Nemotron has not answered by then
# MODEL_READ_FALLBACK=gemini-4-hydrogen  # the Gemini model that reads the page in that case
# MODEL_REASON=gemini-4-argon          # gemini-4-carbon is stronger, gemini-4-hydrogen is faster
# MODEL_IMAGE=gemini-nano-banana-2.1   # gemini-3.1-flash-lite-image is the cheaper fallback
# MODEL_TTS=gemini-3.8-flash-tts       # Gemini speech; the fallback when ElevenLabs is set
# ELEVEN_LABS_API_KEY=                 # elevenlabs.io; with ELEVEN_LABS_VOICE_ID, ElevenLabs speaks the answer.
# ELEVEN_LABS_VOICE_ID=                #   On Modal these come from the separate secrets ELEVEN_LABS_KEY and ELEVVOICE_ID
# MODEL_TTS_ELEVENLABS=eleven_flash_v2_5
# STAGE_TIMEOUT_S=25                  # per stage; keep below the phone's 30 s idle limit
# REQUEST_TIMEOUT_S=85                # whole request; keep below the phone's 90 s overall limit
# WS_MAX_CONNECTIONS=20               # open /ws sockets per container; more get HTTP 503 before upgrade
# STT_DEBUG_LOG=off                   # on: append every transcript to a JSONL file (glasses test runs only;
#                                     # it stores user speech, REQ-OBS-02). On Modal the file is on the
#                                     # metalab-stt-logs Volume: modal volume get metalab-stt-logs transcripts.jsonl
# STT_DEBUG_LOG_PATH=/stt-logs/transcripts.jsonl

# Optional /ws auth, OFF by default (contracts/LIFECYCLE.md, "Optional auth handoff"). Turn it on only
# after the iOS client is shown to send `Authorization: Bearer <token>` over WSS and the owners agree
# the rollout. While on, anything else gets a bare HTTP 401 before upgrade, and on with no token
# refuses everyone. The token goes only in the Modal secret, never in a URL, JSON or logs.
# WS_AUTH=off
# WS_AUTH_TOKEN=
# WS_TRUST_FORWARDED_PROTO=off      # on only where every request comes through a TLS proxy (Modal); then
#                                     # X-Forwarded-Proto: https counts as WSS. Off: only the server's own scheme counts

# IMAGE_WAIT_S=25                     # how long GET /img/<id> waits for a picture still being drawn

# Not read by the app: read by `modal deploy` from your shell, not from the Modal secret.
# MODAL_MIN_CONTAINERS=0              # set 1 for demo day: one container stays warm (and billed)
# The Modal CLI uses these to deploy (or run `modal token new` once instead).
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
