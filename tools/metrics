#!/usr/bin/env bash
# Trust metrics for the agent PR pipeline, computed from GitHub. Needs `gh` (authenticated) and python3.
# Usage: tools/metrics [--since <pr-number>] [--json]   repo-wide table (default --since 67, the first product PR)
#        tools/metrics --areas [--since <n>] [--json]  per-area track record and trust: earned or withdrawn
#        tools/metrics --pr <N>                         the trust header for one PR (markdown, used by pr-header.yml)
#        tools/metrics --gate <N>                       the `trust` status for one PR: exit 0 pass, 3 held (trust.yml)
#        tools/metrics --selftest                       offline checks of the escape and trust rules
# Escapes: an issue labelled `escape` with `Introduced-by: #<PR>` lines records a defect that reached main past
# review (spot-check, live run or incident). An area with an open escape has its trust withdrawn: owner merge.
# --gate holds a PR that touches such an area until the area owner or the lead approves its head commit.
# Env: METRICS_REPO (default: the current gh repo); METRICS_TABLE, a file holding a pre-rendered repo-wide table for --pr. Definitions: docs/TIETO_CONCEPT_CARD.md section 5.
set -euo pipefail
if [ "${1:-}" = "--selftest" ]; then
  REPO="${METRICS_REPO:-selftest/selftest}"  # offline: needs neither gh, a network nor credentials
else
  command -v gh >/dev/null 2>&1 || { echo "metrics: gh not found (https://cli.github.com)" >&2; exit 1; }
  REPO="${METRICS_REPO:-$(gh repo view --json nameWithOwner --jq .nameWithOwner)}"
fi
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export REPO ROOT
exec python3 - "$@" <<'PY'
import json, os, re, statistics, subprocess, sys
from datetime import datetime, timezone

REPO, ROOT = os.environ["REPO"], os.environ["ROOT"]
OWNER, NAME = REPO.split("/")
MARKER = "<!-- metalab-pr-header -->"
SIGNOFF_START, SIGNOFF_END = "<!-- signoff:start -->", "<!-- signoff:end -->"
PROTECTED = re.compile(r"^(\.github|\.claude|\.agents|contracts)/")
REQ = re.compile(r"REQ-[A-Z]+-[0-9]+")
FIXER_PREFIX = "fix: address greptile review"
# Same order as AGENTS.md section 4 and .github/CODEOWNERS (used when CODEOWNERS is missing).
DEFAULT_OWNERS = [("/.github/", "@moterodiaz"), ("/.claude/", "@moterodiaz"), ("/.agents/", "@moterodiaz"),
                  ("/contracts/", "@moterodiaz"), ("/docs/", "@moterodiaz"), ("/ios/", "@maksymmatviievskyi"),
                  ("/backend/app/", "@Ahm3d-KA"), ("/backend/stt/", "@Ahm3d-KA"), ("/backend/ai/", "@Marcus228")]
LEAD = "@moterodiaz"

def usage(code=1):
    print("usage: tools/metrics [--since <pr-number>] [--json] | --areas [--since <n>] [--json] | --pr <N> | --gate <N> | --selftest", file=sys.stderr)
    sys.exit(code)

def gh(*args):
    return subprocess.run(["gh", *args], capture_output=True, text=True, check=True).stdout

def graphql(query, **vars):
    args = ["api", "graphql", "-f", f"query={query}"]
    for k, v in vars.items():
        if v is not None:
            args += ["-F" if isinstance(v, int) else "-f", f"{k}={v}"]
    return json.loads(gh(*args))["data"]["repository"]

THREADS = "reviewThreads(first:100){totalCount nodes{isResolved path line comments(first:30){nodes{author{login} body url}}}}"
PR_FIELDS = f"""number title body state createdAt mergedAt author{{login}} files(first:100){{totalCount nodes{{path}}}}
  commits(first:100){{nodes{{commit{{message}}}}}}
  comments(first:100){{nodes{{author{{login}} body url}}}}
  {THREADS}"""

def pr_files(p):
    """Paths of a PR; pages through REST when GraphQL returned only the first 100 files."""
    if p["files"]["totalCount"] > len(p["files"]["nodes"]):
        return [f for f in gh("api", "--paginate", f"repos/{REPO}/pulls/{p['number']}/files?per_page=100",
                              "--jq", ".[] | .filename, (.previous_filename // empty)").splitlines() if f]
    return [f["path"] for f in p["files"]["nodes"]]

def all_prs():
    # 50 PRs per page keeps the query far below GitHub's 500,000-node limit (never ask gh pr list for commits).
    q = f"query($o:String!,$n:String!,$c:String){{repository(owner:$o,name:$n){{pullRequests(first:50,after:$c,orderBy:{{field:CREATED_AT,direction:ASC}}){{pageInfo{{hasNextPage endCursor}} nodes{{{PR_FIELDS}}}}}}}}}"
    out, cursor = [], None
    while True:
        page = graphql(q, o=OWNER, n=NAME, c=cursor)["pullRequests"]
        out += page["nodes"]
        if not page["pageInfo"]["hasNextPage"]:
            return out
        cursor = page["pageInfo"]["endCursor"]

# A disposition is how a reply opens (AGENTS.md section 3 rule 8), not words inside its explanation.
DISPOSITIONS = [("escalated", re.compile(r"(needs human|left open for a human)")),
                ("rejected", re.compile(r"not changing")),
                ("fixed", re.compile(r"((already )?fixed in|\w+ in [0-9a-f]{7,40}\b)"))]

def classify(thread):
    found = None
    for c in thread["comments"]["nodes"][1:]:
        login = (c["author"] or {}).get("login") or ""
        if "greptile" in login:
            continue
        opening = re.sub(r"^(\[[^\]]*\]\s*)+", "", c["body"].strip()).lower()
        for kind, pattern in DISPOSITIONS:
            if pattern.match(opening):
                found = kind  # the latest reply with a disposition wins
                break
    return found or ("silent" if thread["isResolved"] else "open")

def ai_threads(pr):
    return [t for t in pr["reviewThreads"]["nodes"]
            if t["comments"]["nodes"] and "greptile" in ((t["comments"]["nodes"][0]["author"] or {}).get("login") or "")]

def needs_human(pr):
    return [c for c in pr["comments"]["nodes"] if "needs human" in c["body"] and MARKER not in c["body"]]

def fixer_commits(pr):
    return sum(c["commit"]["message"].startswith(FIXER_PREFIX) for c in pr["commits"]["nodes"])

def ts(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00"))

def pct(a, b):
    return round(100 * a / b, 1) if b else None

INTRODUCED_BY = re.compile(r"^\s*introduced-by:\s*(.+)$", re.I | re.M)

def introduced_by(body):
    """PR numbers named on `Introduced-by:` lines of an escape issue."""
    return sorted({int(n) for line in INTRODUCED_BY.findall(body or "") for n in re.findall(r"#(\d+)", line)})

def escape_issues(state="all", limit=500):
    out = gh("issue", "list", "-R", REPO, "--label", "escape", "--state", state, "--limit", str(limit),
             "--json", "number,state,body")
    issues = json.loads(out)
    if len(issues) >= limit:
        # A full page may hide older escapes; the gate must not pass on an incomplete read.
        print(f"metrics: escape list hit the {limit}-issue limit and may be incomplete", file=sys.stderr)
        sys.exit(1)
    return [{"number": i["number"], "open": i["state"] == "OPEN", "prs": introduced_by(i["body"])}
            for i in issues]

def withdrawn_areas(areas, open_escapes_by_area):
    """Areas of this PR whose trust is withdrawn, with the open escapes that withdrew it."""
    return {a: sorted(open_escapes_by_area[a]) for a in sorted(areas) if open_escapes_by_area.get(a)}

def open_escapes_by_area():
    """area -> open escape issues, from the files of each open escape's introducing PRs."""
    out = {}
    for e in escape_issues("open", 5000):
        if not e["open"]:
            continue
        for n in e["prs"]:
            files = gh("api", "--paginate", f"repos/{REPO}/pulls/{n}/files?per_page=100", "--jq", ".[] | .filename, (.previous_filename // empty)").split()
            for area in pr_areas(files):
                out.setdefault(area, set()).add(e["number"])
    return out

REVERTS = re.compile(r"^\s*reverts\s+(?:[\w.-]+/[\w.-]+)?#(\d+)", re.I | re.M)
REVERT_TITLE = re.compile(r'^revert\s+"(.+)"\s*$', re.I)

def revert_target(revert, titles):
    """The PR a revert undoes: GitHub's `Reverts owner/repo#N` line, else its default title
    `Revert "<original title>"`; other #N mentions in the text are not targets."""
    m = REVERTS.search(revert["body"] or "")
    if m and int(m.group(1)) in titles:
        return int(m.group(1))
    t = REVERT_TITLE.match(revert["title"])
    if t:
        same = [n for n, title in titles.items() if title == t.group(1) and n != revert["number"]]
        if len(same) == 1:
            return same[0]
    return None

def affected_prs(escaped, reverts, titles):
    """Distinct merged PRs that let a defect reach main. A revert counts its target once, not also
    itself; a revert whose target cannot be read counts as itself. titles: merged PR number -> title."""
    affected = set(escaped) & set(titles)
    for p in reverts:
        target = revert_target(p, titles)
        affected.add(target if target is not None else p["number"])
    return affected

def area_trust(open_escapes):
    """Trust is earned per area and withdrawn after an escape, until the escape is closed with its fix."""
    return "withdrawn" if open_escapes else "earned"

def head_approvers(reviews, head):
    """Logins (with @) whose latest approving or blocking review approves the head commit.
    reviews: (login, state, commit_id) oldest first; a comment-only review changes nothing."""
    latest = {}
    for login, state, commit in reviews:
        if state in ("APPROVED", "CHANGES_REQUESTED", "DISMISSED"):
            latest[login] = (state, commit)
    return {"@" + login for login, (state, commit) in latest.items() if state == "APPROVED" and commit == head}

def gate(areas, open_by_area, approvers):
    """The `trust` status: (passes, description). An area with an open escape holds the PR until
    its owner or the lead approves the head commit (the lead because GitHub refuses self-approval)."""
    held = {a: nums for a, nums in withdrawn_areas(areas, open_by_area).items() if not approvers & {a, LEAD}}
    if held:
        why = "; ".join(f"{a} trust withdrawn ({', '.join(f'#{n}' for n in nums)})" for a, nums in held.items())
        return False, f"held: {why}; needs {' or '.join(sorted({*held, LEAD}))} to approve the head commit"
    approved = sorted(withdrawn_areas(areas, open_by_area))
    if approved:
        return True, f"owner-approved head commit for withdrawn area(s) {', '.join(approved)}"
    return True, f"trust earned in {', '.join(sorted(areas))}"

def gate_pr(number):
    pr = json.loads(gh("api", f"repos/{REPO}/pulls/{number}"))
    files = [f for f in gh("api", "--paginate", f"repos/{REPO}/pulls/{number}/files?per_page=100",
                           "--jq", ".[] | .filename, (.previous_filename // empty)").splitlines() if f]
    reviews = [tuple(line.split("\t")) for line in gh("api", "--paginate", f"repos/{REPO}/pulls/{number}/reviews?per_page=100",
               "--jq", ".[] | [.user.login, .state, .commit_id] | @tsv").splitlines() if line]
    return gate(pr_areas(files), open_escapes_by_area(), head_approvers(reviews, pr["head"]["sha"]))

def repo_metrics(since):
    prs = [p for p in all_prs() if p["number"] >= since]
    merged = [p for p in prs if p["mergedAt"]]
    ttm = [(ts(p["mergedAt"]) - ts(p["createdAt"])).total_seconds() / 60 for p in merged]
    kinds = [classify(t) for p in prs for t in ai_threads(p)]
    count = {k: kinds.count(k) for k in ("fixed", "rejected", "escalated", "silent", "open")}
    disposed = count["fixed"] + count["rejected"] + count["escalated"]
    routed = [p for p in prs if needs_human(p)]
    reverts = [p for p in merged if re.match(r"revert", p["title"], re.I)]
    merged_numbers = {p["number"] for p in merged}
    escapes = [e for e in escape_issues() if set(e["prs"]) & merged_numbers]
    escaped_prs = {n for e in escapes for n in e["prs"]} & merged_numbers
    affected = affected_prs(escaped_prs, reverts, {p["number"]: p["title"] for p in merged})
    with_req = [p for p in prs if REQ.search(p["title"] + " " + (p["body"] or ""))]
    fixer = sum(fixer_commits(p) for p in prs)
    runs = json.loads(gh("run", "list", "-R", REPO, "--workflow", "ci.yml", "--limit", "100", "--json", "conclusion"))
    done = [r for r in runs if r["conclusion"]]
    return {
        "since_pr": since,
        "prs_opened": len(prs),
        "prs_merged": len(merged),
        "ttm_median_min": round(statistics.median(ttm), 1) if ttm else None,
        "ttm_mean_min": round(statistics.mean(ttm), 1) if ttm else None,
        "ttm_max_min": round(max(ttm), 1) if ttm else None,
        "threads_total": len(kinds),
        "threads_fixed": count["fixed"],
        "threads_rejected": count["rejected"],
        "threads_escalated": count["escalated"],
        "threads_silent": count["silent"],
        "threads_open": count["open"],
        "disposition_coverage_pct": pct(disposed, len(kinds)),
        "ai_acceptance_pct": pct(count["fixed"], count["fixed"] + count["rejected"]),
        "fixer_commits": fixer,
        "fixer_commits_per_pr": round(fixer / len(prs), 2) if prs else None,
        "prs_routed_to_human": len(routed),
        "routed_to_human_pct": pct(len(routed), len(prs)),
        "needs_human_comments": sum(len(needs_human(p)) for p in prs),
        "reverts": len(reverts),
        "escapes": len(escapes),
        "escapes_open": sum(e["open"] for e in escapes),
        "prs_with_escape": len(escaped_prs),
        # Outcome, not activity: merged PRs that were reverted or let a defect reach main past review.
        "escape_rate_pct": pct(len(affected), len(merged)),
        "prs_with_req_id": len(with_req),
        "req_id_coverage_pct": pct(len(with_req), len(prs)),
        "ci_runs_success_pct": pct(sum(r["conclusion"] == "success" for r in done), len(done)),
        "measured_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    }

LABELS = [("prs_opened", "PRs opened"), ("prs_merged", "PRs merged"), ("ttm_median_min", "Time to merge, median (min)"),
          ("ttm_mean_min", "Time to merge, mean (min)"), ("threads_total", "AI review threads"),
          ("threads_fixed", "Threads fixed"), ("threads_rejected", "Threads rejected with a reason"),
          ("threads_escalated", "Threads escalated to a human"), ("threads_silent", "Threads resolved in silence"),
          ("threads_open", "Threads still open"), ("disposition_coverage_pct", "Disposition coverage (%)"),
          ("ai_acceptance_pct", "AI finding acceptance (%)"), ("fixer_commits", "claude-fix commits"),
          ("prs_routed_to_human", "PRs routed to a human"), ("routed_to_human_pct", "Share routed to a human (%)"),
          ("reverts", "Reverts"), ("escapes", "Escapes recorded (label `escape`)"),
          ("escapes_open", "Escapes still open"), ("prs_with_escape", "Merged PRs with an escape"),
          ("escape_rate_pct", "Escape rate: reverted or escaped PRs (%)"), ("prs_with_req_id", "PRs with a REQ id"),
          ("req_id_coverage_pct", "REQ id coverage (%)"), ("ci_runs_success_pct", "ci runs succeeded, last 100 (%)")]

def table(m):
    rows = ["| Metric | Value |", "|---|---|"]
    rows += [f"| {label} | {'n/a' if m[key] is None else m[key]} |" for key, label in LABELS]
    return "\n".join(rows) + f"\n\nPRs #{m['since_pr']} onwards, measured {m['measured_at']} by `tools/metrics`."

def owners_table():
    path = os.path.join(ROOT, ".github", "CODEOWNERS")
    if not os.path.exists(path):
        return DEFAULT_OWNERS
    rules = []
    for line in open(path):
        parts = line.split("#", 1)[0].split()
        if len(parts) >= 2:
            rules.append((parts[0], " ".join(parts[1:])))
    return rules or DEFAULT_OWNERS

def matched_owner(path, rules=None):
    """The CODEOWNERS owner of path, or None when no rule matches (the last matching rule wins)."""
    found = None
    for pattern, owner in rules if rules is not None else owners_table():
        if ("/" + path).startswith(pattern if pattern.endswith("/") else pattern + "/") or "/" + path == pattern:
            found = owner
    return found

def owner_of(path):
    return matched_owner(path) or LEAD

def pr_areas(paths, rules=None):
    """Areas a PR counts for: owners of the files it changes. Files no rule covers (shared tests,
    tools/, AGENTS.md) count for no area, so they do not inflate the lead's track record; a PR
    that only changes such files counts for the lead."""
    return {o for o in (matched_owner(f, rules) for f in paths) if o} or {LEAD}

def area_metrics(since):
    """Track record per owner area (CODEOWNERS), with trust earned or withdrawn."""
    merged = [p for p in all_prs() if p["number"] >= since and p["mergedAt"]]
    escapes = escape_issues()
    open_now = open_escapes_by_area()  # current trust uses every open escape, whatever --since says
    areas = {}
    for p in merged:
        for owner in pr_areas(pr_files(p)):
            a = areas.setdefault(owner, {"prs": set(), "ttm": [], "kinds": []})
            a["prs"].add(p["number"])
            a["ttm"].append((ts(p["mergedAt"]) - ts(p["createdAt"])).total_seconds() / 60)
            a["kinds"] += [classify(t) for t in ai_threads(p)]
    rows = []
    for owner, a in sorted(areas.items()):
        mine = [e for e in escapes if set(e["prs"]) & a["prs"]]
        open_ = sorted(open_now.get(owner, set()))
        k = a["kinds"]
        rows.append({"area": owner, "prs_merged": len(a["prs"]), "ttm_median_min": round(statistics.median(a["ttm"]), 1),
                     "threads": len(k), "fixed": k.count("fixed"), "rejected": k.count("rejected"),
                     "silent": k.count("silent"), "escapes": len(mine), "escapes_open": open_,
                     "escape_rate_pct": pct(len({n for e in mine for n in e["prs"]} & a["prs"]), len(a["prs"])),
                     "trust": area_trust(open_)})
    return {"since_pr": since, "areas": rows, "measured_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}

def areas_table(m):
    rows = ["| Area (owner) | PRs merged | Median TTM (min) | AI threads | Fixed | Rejected | Silent | Escapes | Escape rate (%) | Trust |",
            "|---|---|---|---|---|---|---|---|---|---|"]
    for r in m["areas"]:
        trust = r["trust"] + (" (owner merge until " + ", ".join(f"#{n}" for n in r["escapes_open"]) + " closes)" if r["escapes_open"] else "")
        rows.append(f"| {r['area']} | {r['prs_merged']} | {r['ttm_median_min']} | {r['threads']} | {r['fixed']} | {r['rejected']} "
                    f"| {r['silent']} | {r['escapes']} | {r['escape_rate_pct']} | {trust} |")
    return "\n".join(rows) + (f"\n\nPRs #{m['since_pr']} onwards, measured {m['measured_at']} by `tools/metrics --areas`. "
                              "A PR counts for every area whose files it changes. Escapes come from issues labelled `escape`.")

def selftest():
    assert introduced_by("Found in a spot-check.\nIntroduced-by: #86, #68\nintroduced-by:#74") == [68, 74, 86]
    assert introduced_by("No marker here #12") == []
    assert introduced_by(None) == []
    assert area_trust([]) == "earned" and area_trust([140]) == "withdrawn"
    assert withdrawn_areas({"@core", "@ai"}, {"@core": {140}, "@ios": {141}}) == {"@core": [140]}
    assert withdrawn_areas({"@ai"}, {"@core": {140}}) == {}
    rules = [("/contracts/", "@lead"), ("/backend/app/", "@core"), ("/backend/ai/", "@ai")]
    assert pr_areas(["backend/app/main.py", "backend/tests/test_ws.py"], rules) == {"@core"}
    assert pr_areas(["backend/ai/x.py", "backend/app/pipeline.py"], rules) == {"@ai", "@core"}
    assert pr_areas(["backend/tests/test_ws.py", "AGENTS.md"], rules) == {LEAD}
    assert pct(0, 0) is None and pct(1, 4) == 25.0
    assert gate({"@core"}, {}, set()) == (True, "trust earned in @core")  # earned
    held, why = gate({"@core", "@ai"}, {"@core": {140}}, set())  # withdrawn, nobody approved
    assert not held and "@core trust withdrawn (#140)" in why and "@ai" not in why, why
    assert gate({"@core"}, {"@core": {140}}, {"@core"})[0] and gate({"@core"}, {"@core": {140}}, {LEAD})[0]
    assert not gate({"@core"}, {"@core": {140}}, {"@ai"})[0]  # only the area owner or the lead
    assert gate({"@core"}, {"@ai": {141}}, set())[0]  # another area's escape does not hold this PR
    reviews = [("core", "APPROVED", "old"), ("ai", "APPROVED", "head"), ("lead", "APPROVED", "head"),
               ("lead", "COMMENTED", "head"), ("x", "APPROVED", "head"), ("x", "CHANGES_REQUESTED", "head")]
    assert head_approvers(reviews, "head") == {"@ai", "@lead"}  # stale and superseded approvals do not count
    titles = {9: "chore: y", 10: "feat: x", 11: 'Revert "feat: x"', 12: "Revert y"}
    assert affected_prs({10}, [{"number": 11, "title": 'Revert "feat: x"', "body": "Reverts o/r#10"}], titles) == {10}
    mention = {"number": 11, "title": "Undo x", "body": "Reverts #10\n\nFollow-up work is in #9."}
    assert affected_prs(set(), [mention], titles) == {10}  # #9 is only mentioned, not reverted
    assert affected_prs(set(), [{"number": 11, "title": 'Revert "feat: x"', "body": ""}], titles) == {10}  # by title
    assert affected_prs(set(), [{"number": 12, "title": "Revert y", "body": "no link"}], titles) == {12}
    print("metrics selftest: OK")

def requirement_text(req):
    try:
        for line in open(os.path.join(ROOT, "docs", "REQUIREMENTS.md")):
            cells = [c.strip() for c in line.split("|")]
            if len(cells) > 4 and cells[1] == req:
                return cells[3]
    except OSError:
        pass
    return None

def check_lines(pr):
    nodes = ((pr["commits"]["nodes"] or [{}])[-1].get("commit") or {}).get("statusCheckRollup") or {}
    out = {}
    for n in (nodes.get("contexts") or {}).get("nodes", []):
        name = n.get("name") or n.get("context")
        state = (n.get("conclusion") or n.get("status") or n.get("state") or "pending").lower()
        out[name] = (state, n.get("detailsUrl") or n.get("targetUrl"))
    return out

def shared_table():
    # A sweep over many PRs renders the repo-wide table once and passes it in (pr-header.yml).
    path = os.environ.get("METRICS_TABLE")
    if path and os.path.exists(path):
        return open(path).read().strip()
    return table(repo_metrics(67))

def header(number):
    q = f"""query($o:String!,$n:String!,$p:Int!){{repository(owner:$o,name:$n){{pullRequest(number:$p){{
      number title body labels(first:20){{nodes{{name}}}}
      allCommits: commits(first:100){{totalCount nodes{{commit{{message}}}}}}
      commits(last:1){{nodes{{commit{{statusCheckRollup{{contexts(first:30){{nodes{{
        ... on CheckRun{{name conclusion status detailsUrl}} ... on StatusContext{{context state targetUrl}}}}}}}}}}}}}}
      comments(first:100){{totalCount nodes{{author{{login}} body url}}}}
      {THREADS}}}}}}}"""
    pr = graphql(q, o=OWNER, n=NAME, p=number)["pullRequest"]
    # REST pages through up to 3000 files; a rename counts under both its old and new path.
    files = [p for p in gh("api", "--paginate", f"repos/{REPO}/pulls/{number}/files?per_page=100",
                           "--jq", ".[] | .filename, (.previous_filename // empty)").splitlines() if p]
    labels = [l["name"] for l in pr["labels"]["nodes"]]
    reqs = sorted(set(REQ.findall(pr["title"] + " " + (pr["body"] or ""))))
    protected = [f for f in files if PROTECTED.match(f)]
    withdrawn = withdrawn_areas(pr_areas(files), open_escapes_by_area())
    tier = "human-merge" if protected or withdrawn or "no-auto-merge" in labels else "auto-merge allowed"
    owners = sorted({owner_of(f) for f in files}) or [LEAD]
    threads = ai_threads(pr)
    kinds = [classify(t) for t in threads]
    fixer = sum(c["commit"]["message"].startswith(FIXER_PREFIX) for c in pr["allCommits"]["nodes"])
    checks = check_lines(pr)
    out = [MARKER, f"## Trust header · {', '.join(reqs) or 'no REQ id'} · {tier}"]
    if reqs:
        out += [f"**Requirement:** `{r}`: {requirement_text(r) or 'not found in docs/REQUIREMENTS.md'}" for r in reqs]
    else:
        out.append("**Requirement:** missing. Add an id from `docs/REQUIREMENTS.md` to the title or body (AGENTS.md §3 rule 7).")
    reasons = []
    if protected:
        reasons.append(f"protected paths: {', '.join(f'`{p}`' for p in protected)}")
    for area, nums in withdrawn.items():
        reasons.append(f"trust withdrawn for {area} until open escape {', '.join(f'#{n}' for n in nums)} closes")
    if "no-auto-merge" in labels:
        reasons.append("labelled `no-auto-merge`")
    why = "; ".join(reasons) or "no protected path changed, no open escape in its areas"
    out += [f"**Risk tier:** {tier} ({why}; AGENTS.md §3 rule 9)", f"**Named owner(s):** {' '.join(owners)}", "", "### Verified by AI"]
    for name in ("ci", "Greptile Review"):
        state, url = checks.get(name, ("not run yet", None))
        out.append(f"- {name}: {f'[{state}]({url})' if url else state}")
    out.append(f"- Review threads: {len(threads)} (fixed {kinds.count('fixed')}, rejected {kinds.count('rejected')}, "
               f"escalated {kinds.count('escalated')}, silent {kinds.count('silent')}, open {kinds.count('open')})")
    for t, k in zip(threads, kinds):
        if k in ("silent", "open"):
            out.append(f"  - {k}: [`{t['path']}:{t['line'] or '?'}`]({t['comments']['nodes'][0]['url']})")
    out.append(f"- claude-fix commits on this PR: {fixer} of the 5 cap")
    capped = [what for what, conn in (("review threads", pr["reviewThreads"]), ("comments", pr["comments"]), ("commits", pr["allCommits"]))
              if conn["totalCount"] > len(conn["nodes"])]
    if capped:
        out.append(f"- Incomplete: only the first 100 {', '.join(capped)} were read; counts above are lower bounds.")
    out += ["", "### Refused by AI or escalated to a named human"]
    esc = needs_human(pr) + [c for t, k in zip(threads, kinds) if k == "escalated" for c in t["comments"]["nodes"][1:] if "needs human" in c["body"].lower()]
    if esc:
        for c in esc:
            first = c["body"].strip().splitlines()[0][:200]
            out.append(f"- [{first}]({c['url']}) (@{(c['author'] or {}).get('login', '?')})")
    else:
        out.append("- none")
    # pr-header.yml keeps whatever the owner wrote between these markers when it refreshes the comment.
    out += ["", f"### Human sign-off ({' '.join(owners)})", SIGNOFF_START,
            "- [ ] Checked:", "- [ ] Not checked, and why:", "- [ ] Residual risk accepted:", SIGNOFF_END, "",
            "<details><summary>Pipeline metrics (repo-wide)</summary>", "", shared_table(), "", "</details>"]
    return "\n".join(out)

args = sys.argv[1:]
since, as_json, pr, by_area, gate_n = 67, False, None, False, None
while args:
    a = args.pop(0)
    if a == "--json":
        as_json = True
    elif a == "--areas":
        by_area = True
    elif a == "--selftest":
        selftest()
        sys.exit(0)
    elif a in ("--since", "--pr", "--gate") and args and args[0].isdigit():
        val = int(args.pop(0))
        if a == "--since":
            since = val
        elif a == "--pr":
            pr = val
        else:
            gate_n = val
    elif a in ("-h", "--help"):
        usage(0)
    else:
        usage()
try:
    if gate_n is not None:
        passes, description = gate_pr(gate_n)
        print(description)
        sys.exit(0 if passes else 3)
    if pr is not None:
        print(header(pr))
    elif by_area:
        m = area_metrics(since)
        print(json.dumps(m, indent=2) if as_json else areas_table(m))
    else:
        m = repo_metrics(since)
        print(json.dumps(m, indent=2) if as_json else table(m))
except subprocess.CalledProcessError as e:
    print(f"metrics: gh failed: {e.stderr.strip()[:500]}", file=sys.stderr)
