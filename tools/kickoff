#!/usr/bin/env bash
# Area ownership management for AGENTS.md.
# Usage: tools/kickoff <show|assign <area> <login> [--add]|help>
set -u
[ "${1:-help}" = help ] && { echo "Usage: tools/kickoff <show|assign <area> <login> [--add]|help>"; exit 0; }

die() { echo "kickoff: $*" >&2; exit 1; }
AGENTS_FILE="${TASK_AGENTS_FILE:-$(dirname "$0")/../AGENTS.md}"
[ -f "$AGENTS_FILE" ] || die "AGENTS.md not found: $AGENTS_FILE"

extract_areas() {
  awk '/^\|/ && !/^\|---/ {
    n = split($0, cols, "|")
    if (n < 5) next
    if (index(cols[4], "`") == 0) next
    folders = cols[4]
    gsub(/[ \t`\/]/, "", folders)
    if (folders != "") print folders
  }' "$AGENTS_FILE"
}

cmd_show() {
  awk '/^\|/ && !/^\|---/ {
    n = split($0, cols, "|")
    if (n < 5) next
    if (index(cols[4], "`") == 0) next
    folders = cols[4]
    owner = cols[3]
    gsub(/[ \t`\/]/, "", folders)
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", owner)
    if (folders != "") printf "%-15s %s\n", folders, owner
  }' "$AGENTS_FILE"
}

cmd_assign() {
  local area="${1:-}" login="${2:-}" add=0
  [ $# -ge 2 ] || die "assign needs <area> <login>"
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in --add) add=1 ;; *) die "unknown option: $1" ;; esac
    shift
  done
  [ -n "$area" ] || die "assign needs an area"
  [ -n "$login" ] || die "assign needs a login"
  login="${login#@}"
  [[ "$login" =~ ^[A-Za-z0-9-]+$ ]] || die "invalid login '$login' (must match ^[A-Za-z0-9-]+\$)"

  local known_areas
  known_areas="$(extract_areas)"
  [ -n "$known_areas" ] || die "could not parse area table from AGENTS.md"
  printf '%s\n' "$known_areas" | grep -Fxq -- "$area" || \
    die "unknown area '$area'. Known: $(printf '%s\n' "$known_areas" | tr '\n' ' ' | sed 's/ $//')"

  local tmp
  tmp="$(mktemp)" || die "could not create temp file"

  awk -v area="$area" -v login="$login" -v add="$add" '
    function owner_has_login(owner, lg,    i, n, parts, tok) {
      lg = tolower(lg)
      n = split(tolower(owner), parts, /[ \t,()]+/)
      for (i = 1; i <= n; i++) {
        tok = parts[i]
        sub(/^@/, "", tok)
        if (tok == lg && tok != "") return 1
      }
      return 0
    }
    /^\|/ && !/^\|---/ {
      n = split($0, cols, "|")
      if (n >= 5 && index(cols[4], "`") > 0) {
        folders = cols[4]
        gsub(/[ \t`\/]/, "", folders)
        if (tolower(folders) == tolower(area)) {
          owner = cols[3]
          if (add + 0) {
            if (!owner_has_login(owner, login)) {
              sub(/[[:space:]]+$/, "", owner)
              cols[3] = owner ", @" login " "
            }
          } else {
            cols[3] = " @" login " "
          }
          printf "|"
          for (i = 2; i <= n-1; i++) printf "%s|", cols[i]
          printf "\n"
          next
        }
      }
    }
    { print }
  ' "$AGENTS_FILE" > "$tmp" || { rm -f "$tmp"; die "awk processing failed"; }

  [ -s "$tmp" ] || { rm -f "$tmp"; die "output was empty"; }
  mv "$tmp" "$AGENTS_FILE" || { rm -f "$tmp"; die "could not update AGENTS.md"; }

  printf 'Edited AGENTS.md. Now: commit it from your worktree, open a PR (it self-merges), and run: tools/board post "[ASSIGN] %s -> @%s"\n' \
    "$area" "$login"
}

case "${1:-help}" in
  show)   cmd_show ;;
  assign) shift; cmd_assign "$@" ;;
  help)   echo "Usage: tools/kickoff <show|assign <area> <login> [--add]|help>" ;;
  *)      die "unknown command: $1" ;;
esac
