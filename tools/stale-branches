#!/usr/bin/env bash
# List local branches already merged into main, and optionally delete them.
# Usage: tools/stale-branches [--delete]
set -euo pipefail

while IFS= read -r b; do
  [ -n "$b" ] || continue
  [ "$b" = "main" ] && continue
  echo "$b"
  if [ "${1:-}" = "--delete" ]; then
    git branch -d -- "$b"
  fi
done < <(git branch --merged main --format='%(refname:short)')
