        {"op":"complete","request":"a","out":["card:a"]},
        {"op":"read","session":"s","request":"a","resource":"image","at_ms":900000,"allowed":true}
      ]
    },
    {
      "name": "invalid-cancelled-history-committed",
      "reject": "s.history",
      "events": [
        {"op":"invoke","session":"s","request":"a"},
        {"op":"cancel","session":"s","request":"a","out":["cancelled:a"],"state":{"s":{"history":["a"]}}}
      ]
    },
    {
      "name": "invalid-monotonic-clock-backwards",
